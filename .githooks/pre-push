#!/usr/bin/env bash
# Blocks the push unless the EXACT commits being pushed pass the gates.
# Each pushed SHA is checked out in a clean temporary worktree (no .env, no local/,
# no uncommitted changes), so what is tested is what is published.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"


# (no venv needed: checks use the Python standard library only)

echo "pre-push: secrets gate (full history)..."
if ! "$repo_root/scripts/check_secrets.sh"; then
  echo "pre-push: secrets gate failed — push aborted." >&2
  exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue # branch deletion: nothing to test
  wt="$(mktemp -d "${TMPDIR:-/tmp}/prepush.XXXXXX")"
  git -C "$repo_root" worktree add --quiet --detach "$wt" "$local_sha"
  echo "pre-push: quality gate on $local_ref @ ${local_sha:0:7} (clean checkout)..."
  if ! (cd "$wt" && ./scripts/check_secrets.sh && ./scripts/check.sh); then
    echo "pre-push: checks failed for $local_ref @ ${local_sha:0:7} — push aborted." >&2
    status=1
  fi
  git -C "$repo_root" worktree remove --force "$wt"
  [[ $status -ne 0 ]] && break
done

exit $status
